HOST=0.0.0.0
PORT=3000
SESSION_SECRET=replace-this-with-a-long-random-string
SESSION_TTL=28800
SESSION_COOKIE_SECURE=false
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=youth_aviation_contest
DB_CONNECTION_LIMIT=10

REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=youth-contest:sess:

STORAGE_DRIVER=local

# OSS 生产环境示例（启用时将 STORAGE_DRIVER 改为 oss）
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=your-bucket-name
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 建议填写对浏览器可访问的公网 endpoint 或已绑定证书的自定义域名
OSS_ENDPOINT=https://your-bucket.oss-cn-hangzhou.aliyuncs.com
# ECS 和 OSS 同地域时可填写内网 endpoint，降低流量成本
OSS_INTERNAL_ENDPOINT=
OSS_PREFIX=contest
OSS_SIGNED_URL_EXPIRES=900
OSS_SECURE=true
OSS_CNAME=false

# 可选：四项上传大小限制（MB）
MAX_REPORT_MB=30
MAX_PROOF1_MB=30
MAX_PROOF2_MB=100
MAX_INTEGRITY_MB=30
