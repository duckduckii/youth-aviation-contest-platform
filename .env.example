# 服务监听地址。通常保持 0.0.0.0。
HOST=0.0.0.0

# 应用容器监听端口。宿主机 Nginx 反代到这里。
PORT=3000

# Node cluster worker 数量。建议按机器 CPU 和 RDS 连接数控制。
APP_WORKERS=4

# 是否启用访问日志。
ACCESS_LOG_ENABLED=true

# 慢请求阈值，单位毫秒。
ACCESS_LOG_SLOW_MS=1500

# libuv 线程池大小。主要影响 bcrypt、文件 IO 等任务。
UV_THREADPOOL_SIZE=32

# Session 与登录态签名密钥。正式环境请使用长随机字符串。
SESSION_SECRET=__AUTO_GENERATE_SESSION_SECRET__

# Session 有效期，单位秒。28800 = 8 小时。
SESSION_TTL=28800

# 是否只允许通过 HTTPS 发送 Cookie。正式环境保持 true。
SESSION_COOKIE_SECURE=true

# Cookie 共享域名。主站和下载站跨子域共享登录时填写，如 .example.com。
SESSION_COOKIE_DOMAIN=

# 反向代理层级。ALB -> Nginx -> App 通常填 2。
TRUST_PROXY=2

# 是否启用登录瞬时限流。
LOGIN_ADMISSION_ENABLED=true

# 同时允许处理的登录请求上限。
LOGIN_MAX_INFLIGHT=64

# 登录被限流后，客户端建议等待秒数。
LOGIN_RETRY_AFTER_SECONDS=3

# 登录计数器在 Redis 中的过期时间，单位秒。
LOGIN_SLOT_TTL_SECONDS=30

# MySQL / RDS 主机名。
DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com

# MySQL / RDS 端口。
DB_PORT=3306

# 业务库用户名。
DB_USER=contest_app

# 业务库密码。
DB_PASSWORD=replace-with-rds-password

# 业务数据库名。
DB_NAME=youth_aviation_contest

# 每个 Node worker 的 MySQL 连接池大小。多 worker 场景不要设置过大。
DB_CONNECTION_LIMIT=12

# 仅本地调试 MySQL 容器会使用。云上模式可忽略。
MYSQL_ROOT_PASSWORD=__AUTO_GENERATE_MYSQL_ROOT_PASSWORD__

# Redis 连接串。若填写则优先于 REDIS_HOST / REDIS_PORT。
REDIS_URL=

# Redis / 阿里云 Redis 主机名。
REDIS_HOST=r-bpxxxx.redis.rds.aliyuncs.com

# Redis 端口。
REDIS_PORT=6379

# Redis 密码。
REDIS_PASSWORD=replace-with-redis-password

# Redis 数据库编号。
REDIS_DB=0

# Session 在 Redis 中的 key 前缀。
REDIS_PREFIX=youth-contest:sess:

# 是否关闭 Session touch，减少 Redis 写入。
REDIS_DISABLE_TOUCH=true

# 文件存储驱动。生产固定使用 oss，本地调试可改为 local。
STORAGE_DRIVER=oss

# 管理导出下载的公网入口。普通 app 节点会把导出请求跳转到这里。
EXPORT_PUBLIC_BASE_URL=https://download.example.com

# 导出 ZIP 和 manifest 在 export 节点内的本地目录。
EXPORT_ROOT_DIR=/app/runtime/exports

# 导出分布式锁 key 前缀。
EXPORT_LOCK_PREFIX=youth-contest:export:lock:

# 导出分布式锁超时时间，单位秒。
EXPORT_LOCK_TTL_SECONDS=300

# OSS 地域。
OSS_REGION=oss-cn-hangzhou

# OSS Bucket 名称。
OSS_BUCKET=your-bucket

# OSS AccessKey ID。
OSS_ACCESS_KEY_ID=your-access-key-id

# OSS AccessKey Secret。
OSS_ACCESS_KEY_SECRET=your-access-key-secret

# OSS 公网 Endpoint。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OSS 内网 Endpoint。ECS 与 OSS 同地域时建议填写。
OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com

# 浏览器直传签名使用的 Endpoint 模式。通常用 public。
OSS_DIRECT_UPLOAD_ENDPOINT_MODE=public

# OSS 对象统一前缀。
OSS_PREFIX=contest

# OSS 直传签名有效期，单位秒。
OSS_SIGNED_URL_EXPIRES=900

# 访问 OSS 是否强制 HTTPS。
OSS_SECURE=true

# 是否通过自定义 CNAME 访问 OSS。
OSS_CNAME=false

# 研究设计报告最大大小，单位 MB。
MAX_REPORT_MB=30

# 其他证明材料 1 最大大小，单位 MB。
MAX_PROOF1_MB=30

# 其他证明材料 2 最大大小，单位 MB。
MAX_PROOF2_MB=100

# 诚信承诺书最大大小，单位 MB。
MAX_INTEGRITY_MB=30
