<%- include('partials/head', { pageTitle }) %>
<%- include('partials/top-nav') %>

<main class="main-container">
  <% const pageData = importData || {}; %>
  <% const requiredHeaders = pageData.requiredHeaders || []; %>
  <% const recentBatches = pageData.recentBatches || []; %>
  <% const result = importResult || null; %>
  <% const statusLabels = { RUNNING: '导入中', SUCCESS: '完成', FAILED: '失败' }; %>
  <% const statusClasses = { RUNNING: 'draft', SUCCESS: 'submitted', FAILED: 'failed' }; %>

  <%- include('partials/flash') %>

  <section class="section-card">
    <div class="batch-page-head">
      <div>
        <h1 class="section-title">报名导入</h1>
        <p class="section-tip">仅管理员可导入报名主数据。系统会按报名号新增账号或更新已有账号信息，不会重置已存在账号的密码。</p>
      </div>
      <div class="batch-summary-pills">
        <span class="account-pill">仅支持 `.xlsx`</span>
        <span class="account-pill">初始密码 = 报名号后 8 位</span>
        <span class="account-pill">已导入批次 <%= recentBatches.length %> 条</span>
      </div>
    </div>

    <div class="batch-config-row">
      <div class="batch-config-inline">
        <form method="post" action="/admin/registration-import" enctype="multipart/form-data">
          <div class="field-group">
            <label class="field-label" for="registrationFile">报名列表 Excel</label>
            <input
              class="input"
              id="registrationFile"
              name="registrationFile"
              type="file"
              accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
              required
            />
          </div>

          <div class="field-group">
            <label class="field-label" for="forcedDirection">预设比赛方向（可选）</label>
            <select class="input" id="forcedDirection" name="forcedDirection">
              <option value="">不预设，用户登录后自行选择</option>
              <% importData.tracks.forEach((track) => { %>
                <option value="<%= track %>"><%= importData.trackLabels[track] %></option>
              <% }) %>
            </select>
            <div class="note-box" style="margin-top: 8px;">
              <strong>知识类：</strong>用户将被锁定为知识类方向，登录后直接进入知识类页面，不可再更改。<br>
              <strong>创新设计类：</strong>用户默认选择创新设计类，登录后直接进入创新类提交页面。
            </div>
          </div>

          <div class="note-box">
            系统会先校验表头、重复报名号、手机号和时间字段格式；手机号支持纯数字或 137****8409 这类脱敏格式。校验通过后转入后台任务，可在本页查看进度。
          </div>

          <div class="actions-row compact">
            <button class="primary-btn" type="submit">开始导入</button>
          </div>
        </form>
      </div>
    </div>
  </section>

  <section class="section-card">
    <h2 class="section-title">模板要求</h2>
    <div class="note-box">
      必须包含以下表头，列顺序可以保持和原始导出一致：
    </div>
    <div class="import-header-list">
      <% requiredHeaders.forEach((header) => { %>
        <span class="import-header-chip"><%= header %></span>
      <% }) %>
    </div>
  </section>

  <% if (result) { %>
    <section class="section-card">
      <h2 class="section-title">本次导入任务</h2>

      <div class="dashboard-kpi-grid">
        <div class="kpi-card">
          <div class="kpi-label">源文件</div>
          <div class="kpi-value import-kpi-value"><%= result.sourceFileName %></div>
          <div class="kpi-meta">工作表：<%= result.sourceSheetName %></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">状态</div>
          <div class="kpi-value import-kpi-value"><%= statusLabels[result.status] || result.status %></div>
          <div class="kpi-meta">批次 #<%= result.id %></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">总行数</div>
          <div class="kpi-value"><%= result.totalRows %></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">处理进度</div>
          <div class="kpi-value"><%= result.processedRows %>/<%= result.totalRows %></div>
          <div class="kpi-meta"><%= result.progressPercent %>%</div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">成功行数</div>
          <div class="kpi-value"><%= result.successRows %></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">新增账号</div>
          <div class="kpi-value"><%= result.insertedRows %></div>
        </div>
        <div class="kpi-card">
          <div class="kpi-label">更新账号</div>
          <div class="kpi-value"><%= result.updatedRows %></div>
        </div>
      </div>

      <% if (result.errorMessage) { %>
        <div class="note-box"><%= result.errorMessage %></div>
      <% } %>

      <% if (result.errors && result.errors.length > 0) { %>
        <div class="table-wrap">
          <table class="dashboard-table import-error-table">
            <thead>
              <tr>
                <th>Excel 行号</th>
                <th>报名号</th>
                <th>错误原因</th>
              </tr>
            </thead>
            <tbody>
              <% result.errors.forEach((item) => { %>
                <tr>
                  <td><%= item.rowNumber %></td>
                  <td><%= item.registrationNo || '--' %></td>
                  <td><%= item.message %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% } %>

  <section class="section-card">
    <h2 class="section-title">最近导入批次</h2>
    <div class="table-wrap">
      <table class="dashboard-table">
        <thead>
          <tr>
            <th>批次 ID</th>
            <th>源文件</th>
            <th>工作表</th>
            <th>预设方向</th>
            <th>状态</th>
            <th>进度</th>
            <th>总行数</th>
            <th>新增</th>
            <th>更新</th>
            <th>失败</th>
            <th>操作人</th>
            <th>导入时间</th>
          </tr>
        </thead>
        <tbody id="import-batches-body">
          <% if (recentBatches.length === 0) { %>
            <tr>
              <td colspan="12" class="table-empty">当前还没有导入记录</td>
            </tr>
          <% } %>
          <% recentBatches.forEach((batch) => { %>
            <tr>
              <td><%= batch.id %></td>
              <td title="<%= batch.sourceFileName %>"><%= batch.sourceFileName %></td>
              <td><%= batch.sourceSheetName || '--' %></td>
              <td><%= batch.forcedDirection ? importData.trackLabels[batch.forcedDirection] : '--' %></td>
              <td><span class="status-pill <%= statusClasses[batch.status] || 'neutral' %>"><%= statusLabels[batch.status] || batch.status %></span></td>
              <td>
                <div><%= batch.processedRows %>/<%= batch.totalRows %>（<%= batch.progressPercent %>%）</div>
                <div class="progress-track import-progress-track">
                  <div class="progress-fill <%= batch.status === 'SUCCESS' ? 'success' : (batch.status === 'FAILED' ? 'warning' : '') %>" style="width: <%= batch.progressPercent %>%"></div>
                </div>
              </td>
              <td><%= batch.totalRows %></td>
              <td><%= batch.insertedRows %></td>
              <td><%= batch.updatedRows %></td>
              <td><%= batch.failedRows %></td>
              <td><%= batch.createdBy %></td>
              <td><%= batch.createdAt ? new Date(batch.createdAt).toLocaleString('zh-CN', { hour12: false }) : '--' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </section>
</main>

<script>
  (() => {
    const tbody = document.getElementById('import-batches-body');
    if (!tbody) return;

    const statusLabels = { RUNNING: '导入中', SUCCESS: '完成', FAILED: '失败' };
    const statusClasses = { RUNNING: 'draft', SUCCESS: 'submitted', FAILED: 'failed' };
    const trackLabels = <%- JSON.stringify(importData.trackLabels || {}) %>;

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, (char) => ({
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#39;',
      }[char]));
    }

    function formatDate(value) {
      if (!value) return '--';
      const date = new Date(value);
      if (Number.isNaN(date.getTime())) return '--';
      return date.toLocaleString('zh-CN', { hour12: false });
    }

    function renderBatch(batch) {
      const status = batch.status || 'SUCCESS';
      const progressClass = status === 'SUCCESS' ? 'success' : (status === 'FAILED' ? 'warning' : '');
      const directionLabel = batch.forcedDirection ? trackLabels[batch.forcedDirection] : '--';
      return `
        <tr>
          <td>${escapeHtml(batch.id)}</td>
          <td title="${escapeHtml(batch.sourceFileName)}">${escapeHtml(batch.sourceFileName)}</td>
          <td>${escapeHtml(batch.sourceSheetName || '--')}</td>
          <td>${escapeHtml(directionLabel || '--')}</td>
          <td><span class="status-pill ${statusClasses[status] || 'neutral'}">${escapeHtml(statusLabels[status] || status)}</span></td>
          <td>
            <div>${escapeHtml(batch.processedRows)}/${escapeHtml(batch.totalRows)}（${escapeHtml(batch.progressPercent)}%）</div>
            <div class="progress-track import-progress-track">
              <div class="progress-fill ${progressClass}" style="width: ${Number(batch.progressPercent) || 0}%"></div>
            </div>
          </td>
          <td>${escapeHtml(batch.totalRows)}</td>
          <td>${escapeHtml(batch.insertedRows)}</td>
          <td>${escapeHtml(batch.updatedRows)}</td>
          <td>${escapeHtml(batch.failedRows)}</td>
          <td>${escapeHtml(batch.createdBy)}</td>
          <td>${escapeHtml(formatDate(batch.createdAt))}</td>
        </tr>
      `;
    }

    async function refreshImportBatches() {
      try {
        const response = await fetch('/admin/registration-import/status', {
          headers: { Accept: 'application/json' },
          credentials: 'same-origin',
        });
        if (!response.ok) return;
        const data = await response.json();
        const batches = Array.isArray(data.batches) ? data.batches : [];
        if (batches.length === 0) return;
        tbody.innerHTML = batches.map(renderBatch).join('');
      } catch (error) {
        // Keep the last rendered state if polling fails.
      }
    }

    if (tbody.querySelector('.status-pill.draft')) {
      refreshImportBatches();
      setInterval(refreshImportBatches, 3000);
    }
  })();
</script>

<%- include('partials/footer') %>
