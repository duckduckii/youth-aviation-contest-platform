<%- include('partials/head', { pageTitle }) %>
<%- include('partials/top-nav') %>

<main class="main-container">
  <%- include('partials/flash') %>

  <section class="form-card" style="margin-top:24px; max-width: 620px;">
    <h2>修改密码</h2>
    <div class="note-box">新密码至少8位，修改成功后会自动退出登录，请使用新密码重新登录。</div>

    <form method="post" action="/change-password">
      <div class="field-group">
        <label class="field-label" for="oldPassword">旧密码</label>
        <input class="input" id="oldPassword" name="oldPassword" type="password" required />
      </div>

      <div class="field-group">
        <label class="field-label" for="newPassword">新密码</label>
        <input class="input" id="newPassword" name="newPassword" type="password" minlength="8" required />
      </div>

      <div class="field-group">
        <label class="field-label" for="confirmPassword">确认新密码</label>
        <input class="input" id="confirmPassword" name="confirmPassword" type="password" minlength="8" required />
      </div>

      <div class="actions-row">
        <button class="primary-btn" type="submit">确认修改</button>
        <a class="ghost-btn" href="/portal">返回</a>
      </div>
    </form>
  </section>
</main>

<%- include('partials/footer') %>
