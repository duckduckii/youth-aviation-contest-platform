# ==========================================================
# 第一次部署时，只改下面这些“真正的配置行”。
# 其他内容先不要动。
#
# 你可以直接复制下面这段，到对应变量的位置替换：
#
# SESSION_SECRET=自己生成的一串很长随机字符串
#
# DB_HOST=RDS内网地址
# DB_PORT=3306
# DB_USER=MySQL用户名
# DB_PASSWORD=MySQL密码
# DB_NAME=数据库名
#
# REDIS_URL=redis://<Redis实例ID>:<Redis密码>@<Redis内网地址>:6379/0
# 说明：
# Redis 信息优先填在 REDIS_URL 这一行。
# 如果你用阿里云 Redis / Tair，这是最省事的填法。
#
# STORAGE_DRIVER=oss
# OSS_REGION=Bucket地域，例如 oss-cn-hangzhou
# OSS_BUCKET=Bucket名
# OSS_ACCESS_KEY_ID=RAM AccessKey ID
# OSS_ACCESS_KEY_SECRET=RAM AccessKey Secret
# OSS_ENDPOINT=https://oss-地域.aliyuncs.com
# OSS_INTERNAL_ENDPOINT=https://oss-地域-internal.aliyuncs.com
#
# 如果当前只是“公网 IP + HTTP 联调”，再额外改这 3 行：
# SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_DOMAIN=
# EXPORT_PUBLIC_BASE_URL=
# ==========================================================

# 服务监听地址。云上部署通常保持 0.0.0.0。
HOST=0.0.0.0

# 应用容器内部监听端口。
# 这里默认就是 3000，不要改成 80。
# 外部访问走宿主机 Nginx 的 80 端口，再反代到这里。
PORT=3000

# Node cluster worker 数量。建议结合 ECS 规格和 RDS 连接数设置。
APP_WORKERS=4

# 是否启用访问日志。
ACCESS_LOG_ENABLED=true

# 慢请求阈值，单位毫秒。
ACCESS_LOG_SLOW_MS=1500

# libuv 线程池大小。
UV_THREADPOOL_SIZE=32

# Session 与登录态签名密钥。
SESSION_SECRET=自定义长随机字符串

# Session 有效期，单位秒。
SESSION_TTL=28800

# 正式环境请保持 true。
SESSION_COOKIE_SECURE=true

# 主站和下载站共享登录态时填写顶级域名，如 .example.com。
SESSION_COOKIE_DOMAIN=.example.com

# ALB -> Nginx -> App 通常填写 2。
TRUST_PROXY=2

# 是否启用登录瞬时限流。
LOGIN_ADMISSION_ENABLED=true

# 同时允许处理的登录请求上限。
LOGIN_MAX_INFLIGHT=64

# 登录被限流后建议等待秒数。
LOGIN_RETRY_AFTER_SECONDS=3

# 登录计数器过期时间，单位秒。
LOGIN_SLOT_TTL_SECONDS=30

# 阿里云 RDS 主机名。
DB_HOST=rm-xxxx.mysql.rds.aliyuncs.com

# RDS 端口。
DB_PORT=3306

# 业务库用户名。
# 这里只是示例值，正式环境请改成你自己的 MySQL 用户名。
DB_USER=contest_app

# 业务库密码。
DB_PASSWORD=RDS密码

# 业务数据库名。
DB_NAME=youth_aviation_contest

# 每个 worker 的 MySQL 连接池大小。
DB_CONNECTION_LIMIT=12

# 仅本地调试 MySQL 容器会使用，云上模式可忽略。
MYSQL_ROOT_PASSWORD=仅本地调试才会用到

# Redis 连接串。若填写则优先于 REDIS_HOST / REDIS_PORT。
# 如果你已经有阿里云 Redis / Tair，推荐只填这一行。
# 阿里云 Redis / Tair 若要求账号密码认证，推荐直接写成：
# redis://<实例ID>:<密码>@<内网地址>:6379/0
REDIS_URL=

# 阿里云 Redis 主机名。
REDIS_HOST=r-bpxxxx.redis.rds.aliyuncs.com

# 阿里云 Redis 端口。
REDIS_PORT=6379

# 阿里云 Redis 密码。
REDIS_PASSWORD=Redis密码

# Redis 数据库编号。
REDIS_DB=0

# Session 在 Redis 中的 key 前缀。
REDIS_PREFIX=youth-contest:sess:

# 是否关闭 Session touch。
REDIS_DISABLE_TOUCH=true

# 云上模式固定使用 oss。
STORAGE_DRIVER=oss

# 导出下载公网入口。
# 如果你现在只有一台 ECS 先联调，这一行可以先留空。
# 等后面拆成单独下载域名时，再改成 https://download.example.com
EXPORT_PUBLIC_BASE_URL=https://download.example.com

# 导出 ZIP / manifest 在 export 节点内的本地目录。
EXPORT_ROOT_DIR=/app/runtime/exports

# 导出分布式锁 key 前缀。
EXPORT_LOCK_PREFIX=youth-contest:export:lock:

# 导出分布式锁超时时间，单位秒。
EXPORT_LOCK_TTL_SECONDS=300

# OSS 地域。
OSS_REGION=oss-cn-hangzhou

# OSS Bucket 名称。
OSS_BUCKET=bucket名

# OSS AccessKey ID。
OSS_ACCESS_KEY_ID=RAM_keyId

# OSS AccessKey Secret。
OSS_ACCESS_KEY_SECRET=RAM_keySecret

# OSS 公网 Endpoint。
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com

# OSS 内网 Endpoint。ECS 与 OSS 同地域时建议填写。
OSS_INTERNAL_ENDPOINT=https://oss-cn-hangzhou-internal.aliyuncs.com

# 浏览器直传签名 Endpoint 模式。
OSS_DIRECT_UPLOAD_ENDPOINT_MODE=public

# OSS 对象统一前缀。
OSS_PREFIX=contest

# OSS 直传签名有效期，单位秒。
OSS_SIGNED_URL_EXPIRES=900

# 访问 OSS 是否强制 HTTPS。
OSS_SECURE=true

# 是否通过自定义 CNAME 访问 OSS。
OSS_CNAME=false

# 研究设计报告最大大小，单位 MB。
MAX_REPORT_MB=30

# 其他证明材料 1 最大大小，单位 MB。
MAX_PROOF1_MB=30

# 其他证明材料 2 最大大小，单位 MB。
MAX_PROOF2_MB=100

# 诚信承诺书最大大小，单位 MB。
MAX_INTEGRITY_MB=30
