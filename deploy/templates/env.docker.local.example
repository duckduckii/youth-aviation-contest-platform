# 服务监听地址。本地 Docker 调试通常保持 0.0.0.0。
HOST=0.0.0.0

# 应用容器监听端口。
PORT=3000

# 本地模式 worker 数量。调试时保持较小即可。
APP_WORKERS=2

# 是否启用访问日志。
ACCESS_LOG_ENABLED=true

# 慢请求阈值，单位毫秒。
ACCESS_LOG_SLOW_MS=1500

# libuv 线程池大小。
UV_THREADPOOL_SIZE=32

# Session 与登录态签名密钥。
SESSION_SECRET=__AUTO_GENERATE_SESSION_SECRET__

# Session 有效期，单位秒。
SESSION_TTL=28800

# 本地调试通常不开 HTTPS，因此保持 false。
SESSION_COOKIE_SECURE=false

# 本地调试不需要跨子域共享 Cookie，留空即可。
SESSION_COOKIE_DOMAIN=

# 本地通常只有一层宿主机 Nginx，填写 1。
TRUST_PROXY=1

# 是否启用登录瞬时限流。
LOGIN_ADMISSION_ENABLED=true

# 同时允许处理的登录请求上限。
LOGIN_MAX_INFLIGHT=64

# 登录被限流后建议等待秒数。
LOGIN_RETRY_AFTER_SECONDS=3

# 登录计数器过期时间，单位秒。
LOGIN_SLOT_TTL_SECONDS=30

# 本地 MySQL 容器主机名。
DB_HOST=mysql

# 本地 MySQL 容器端口。
DB_PORT=3306

# 本地业务库用户名。
DB_USER=contest_app

# 本地业务库密码。
DB_PASSWORD=__AUTO_GENERATE_DB_PASSWORD__

# 本地业务数据库名。
DB_NAME=youth_aviation_contest

# 本地单 worker/双 worker 场景连接池不需要太大。
DB_CONNECTION_LIMIT=12

# 本地 MySQL root 密码。
MYSQL_ROOT_PASSWORD=__AUTO_GENERATE_MYSQL_ROOT_PASSWORD__

# 本地模式通常不需要 Redis URL，保持空即可。
REDIS_URL=

# 本地 Redis 容器主机名。
REDIS_HOST=redis

# 本地 Redis 容器端口。
REDIS_PORT=6379

# 本地 Redis 密码。
REDIS_PASSWORD=__AUTO_GENERATE_REDIS_PASSWORD__

# Redis 数据库编号。
REDIS_DB=0

# Session 在 Redis 中的 key 前缀。
REDIS_PREFIX=youth-contest:sess:

# 是否关闭 Session touch。
REDIS_DISABLE_TOUCH=true

# 本地模式文件直接落本地磁盘。
STORAGE_DRIVER=local

# 本地模式不需要导出公网入口，留空即可。
EXPORT_PUBLIC_BASE_URL=

# 本地导出目录。
EXPORT_ROOT_DIR=/app/runtime/exports

# 导出分布式锁 key 前缀。
EXPORT_LOCK_PREFIX=youth-contest:export:lock:

# 导出分布式锁超时时间，单位秒。
EXPORT_LOCK_TTL_SECONDS=300

# 本地模式不使用 OSS，以下参数可留空。
OSS_REGION=

# 本地模式不使用 OSS，以下参数可留空。
OSS_BUCKET=

# 本地模式不使用 OSS，以下参数可留空。
OSS_ACCESS_KEY_ID=

# 本地模式不使用 OSS，以下参数可留空。
OSS_ACCESS_KEY_SECRET=

# 本地模式不使用 OSS，以下参数可留空。
OSS_ENDPOINT=

# 本地模式不使用 OSS，以下参数可留空。
OSS_INTERNAL_ENDPOINT=

# 浏览器直传签名 Endpoint 模式。
OSS_DIRECT_UPLOAD_ENDPOINT_MODE=public

# OSS 对象统一前缀。
OSS_PREFIX=contest

# OSS 直传签名有效期，单位秒。
OSS_SIGNED_URL_EXPIRES=900

# 访问 OSS 是否强制 HTTPS。
OSS_SECURE=true

# 是否通过自定义 CNAME 访问 OSS。
OSS_CNAME=false

# 研究设计报告最大大小，单位 MB。
MAX_REPORT_MB=30

# 其他证明材料 1 最大大小，单位 MB。
MAX_PROOF1_MB=30

# 其他证明材料 2 最大大小，单位 MB。
MAX_PROOF2_MB=100

# 诚信承诺书最大大小，单位 MB。
MAX_INTEGRITY_MB=30
