HOST=0.0.0.0
PORT=3000
APP_WORKERS=8
ACCESS_LOG_ENABLED=true
ACCESS_LOG_SLOW_MS=1500
UV_THREADPOOL_SIZE=32
SESSION_SECRET=replace-with-a-long-random-string
SESSION_TTL=28800
SESSION_COOKIE_SECURE=true
TRUST_PROXY=true
LOGIN_ADMISSION_ENABLED=true
LOGIN_MAX_INFLIGHT=64
LOGIN_RETRY_AFTER_SECONDS=3
LOGIN_SLOT_TTL_SECONDS=30

DB_HOST=mysql
DB_PORT=3306
DB_USER=contest_app
DB_PASSWORD=change-this-db-password
DB_NAME=youth_aviation_contest
DB_CONNECTION_LIMIT=80
MYSQL_ROOT_PASSWORD=change-this-root-password

REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-this-redis-password
REDIS_DB=0
REDIS_PREFIX=youth-contest:sess:
REDIS_DISABLE_TOUCH=true

STORAGE_DRIVER=local
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_INTERNAL_ENDPOINT=
OSS_DIRECT_UPLOAD_ENDPOINT_MODE=public
OSS_PREFIX=contest
OSS_SIGNED_URL_EXPIRES=900
OSS_SECURE=true
OSS_CNAME=false

MAX_REPORT_MB=30
MAX_PROOF1_MB=30
MAX_PROOF2_MB=100
MAX_INTEGRITY_MB=30
